<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
  <meta name="description" content="Acompanhamento Nutricional com João Miranda. Sua alimentação se encaixa na sua rotina, não o contrário." />
  <meta name="theme-color" content="#f59e0b" />
  <title>Acompanhamento | João Miranda Nutricionista</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --amber:       #f59e0b;
      --amber-dark:  #d97706;
      --amber-light: #fcd34d;
      --amber-glow:  rgba(245,158,11,0.15);
      --navy:        #0f1f3d;
      --navy-mid:    #162444;
      --dark:        #080e1a;
      --dark2:       #0d1628;
      --card:        rgba(255,255,255,0.04);
      --card-border: rgba(255,255,255,0.08);
      --text:        #f0eee8;
      --muted:       rgba(240,238,232,0.60);
      --green:       #22c55e;
      --red:         #ef4444;
      --radius-lg:   20px;
      --radius-md:   14px;
      --radius-sm:   10px;
      --max-w:       720px;
    }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--dark);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ─── HERO ─────────────────────────────────── */
    .hero {
      position: relative;
      background: linear-gradient(160deg, var(--navy) 0%, var(--dark) 60%);
      padding: 72px 24px 80px;
      text-align: center;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 90% 60% at 50% 0%, rgba(245,158,11,0.18) 0%, transparent 65%),
        radial-gradient(ellipse 50% 40% at 90% 100%, rgba(245,158,11,0.08) 0%, transparent 60%);
      pointer-events: none;
    }
    .hero-eyebrow {
      display: inline-block;
      padding: 5px 16px;
      border: 1px solid var(--amber);
      border-radius: 100px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 22px;
      opacity: 0;
      animation: fadeUp 0.7s 0.1s ease forwards;
    }
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 5.5vw, 3.2rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.02em;
      max-width: 640px;
      margin: 0 auto 20px;
      opacity: 0;
      animation: fadeUp 0.7s 0.2s ease forwards;
    }
    .hero h1 em {
      font-style: normal;
      background: linear-gradient(135deg, var(--amber), var(--amber-light));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-sub {
      font-size: clamp(0.97rem, 2.5vw, 1.1rem);
      color: var(--muted);
      max-width: 520px;
      margin: 0 auto 36px;
      opacity: 0;
      animation: fadeUp 0.7s 0.3s ease forwards;
    }
    .hero-cta-wrap {
      opacity: 0;
      animation: fadeUp 0.7s 0.4s ease forwards;
    }
    .btn-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 17px 36px;
      background: linear-gradient(135deg, var(--amber), var(--amber-dark));
      color: #1a0e00;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-radius: 100px;
      text-decoration: none;
      box-shadow: 0 10px 32px rgba(245,158,11,0.4), 0 2px 8px rgba(0,0,0,0.3);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .btn-cta:hover { transform: translateY(-3px); box-shadow: 0 18px 42px rgba(245,158,11,0.5); }
    .btn-cta:active { transform: translateY(0); }
    .btn-cta .dots { font-size: 1.1rem; letter-spacing: -2px; }

    /* ─── SECTION BASE ─────────────────────────── */
    section { padding: 72px 24px; }
    .container { max-width: var(--max-w); margin: 0 auto; }
    .section-tag {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 12px;
    }
    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 16px;
    }
    .section-sub {
      font-size: 1rem;
      color: var(--muted);
      line-height: 1.7;
    }
    .divider-amber {
      width: 48px;
      height: 3px;
      background: linear-gradient(90deg, var(--amber), transparent);
      border-radius: 2px;
      margin: 20px 0 32px;
    }

    /* ─── DOR ──────────────────────────────────── */
    .section-dor {
      background: #fff;
      color: var(--navy);
    }
    .section-dor .section-tag { color: var(--amber-dark); }
    .section-dor .section-title { color: var(--navy); }
    .section-dor .section-sub { color: #3a4a6b; }
    .section-dor .divider-amber { background: linear-gradient(90deg, var(--amber-dark), transparent); }

    .pain-intro {
      font-size: 1rem;
      color: #3a4a6b;
      line-height: 1.75;
      margin-bottom: 28px;
    }

    .pain-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 28px;
    }
    @media (max-width: 520px) { .pain-grid { grid-template-columns: 1fr; } }

    .pain-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 16px;
      background: #f8f6f1;
      border-radius: var(--radius-md);
      border-left: 3px solid var(--amber);
    }
    .pain-item .bullet {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--amber);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 1px;
    }
    .pain-item .bullet::after {
      content: '?';
      font-size: 0.65rem;
      font-weight: 800;
      color: #1a0e00;
    }
    .pain-item span { font-size: 0.9rem; font-weight: 500; color: var(--navy); line-height: 1.4; }

    /* ─── QUEM É ────────────────────────────────── */
    .section-quem {
      background: linear-gradient(160deg, var(--navy-mid) 0%, var(--dark2) 100%);
    }
    .quem-layout {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 40px;
      align-items: start;
    }
    @media (max-width: 560px) {
      .quem-layout { grid-template-columns: 1fr; }
      .quem-photo { margin: 0 auto; }
    }
    .quem-photo {
      width: 200px;
      height: 240px;
      border-radius: var(--radius-lg);
      background: linear-gradient(160deg, var(--navy), var(--dark));
      border: 2px solid rgba(245,158,11,0.3);
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 0 1px rgba(245,158,11,0.15);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      font-weight: 900;
      color: var(--amber);
    }
    .quem-text p {
      font-size: 0.97rem;
      color: var(--muted);
      line-height: 1.8;
      margin-bottom: 14px;
    }
    .quem-text p:last-child { margin-bottom: 0; }
    .quem-text strong { color: var(--amber); font-weight: 700; }

    /* ─── COMPARAÇÃO ────────────────────────────── */
    .section-comp {
      background: #fff;
      color: var(--navy);
    }
    .comp-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 36px;
    }
    @media (max-width: 560px) { .comp-grid { grid-template-columns: 1fr; } }

    .comp-card {
      border-radius: var(--radius-lg);
      padding: 28px 24px;
    }
    .comp-card.bad {
      background: #f9f9f9;
      border: 1.5px solid #e8e8e8;
    }
    .comp-card.good {
      background: linear-gradient(160deg, var(--navy) 0%, #1a2f5a 100%);
      border: 1.5px solid rgba(245,158,11,0.4);
      box-shadow: 0 16px 48px rgba(15,31,61,0.18);
    }
    .comp-header {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem;
      font-weight: 700;
      padding: 8px 18px;
      border-radius: 100px;
      display: inline-block;
      margin-bottom: 22px;
    }
    .comp-header.bad { background: var(--navy); color: #fff; }
    .comp-header.good { background: linear-gradient(135deg, var(--amber), var(--amber-dark)); color: #1a0e00; }

    .comp-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .comp-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .comp-card.bad .comp-list li { color: #4a5a7a; }
    .comp-card.good .comp-list li { color: rgba(240,238,232,0.85); }
    .comp-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.75rem;
      font-weight: 900;
      margin-top: 1px;
    }
    .comp-icon.x { background: #fee2e2; color: var(--red); }
    .comp-icon.ok { background: #dcfce7; color: var(--green); }

    .comp-cta-wrap {
      text-align: center;
      margin-top: 40px;
    }
    .btn-cta-light {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 17px 36px;
      background: linear-gradient(135deg, var(--amber), var(--amber-dark));
      color: #1a0e00;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-radius: 100px;
      text-decoration: none;
      box-shadow: 0 10px 32px rgba(245,158,11,0.35);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .btn-cta-light:hover { transform: translateY(-3px); box-shadow: 0 18px 42px rgba(245,158,11,0.5); }

    /* ─── DEPOIMENTOS ───────────────────────────── */
    .section-dep {
      background: linear-gradient(160deg, var(--dark2) 0%, var(--dark) 100%);
    }
    .dep-sub {
      font-size: 0.97rem;
      color: var(--muted);
      margin-bottom: 36px;
      line-height: 1.7;
    }
    .dep-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    @media (max-width: 520px) { .dep-grid { grid-template-columns: 1fr; } }

    .dep-card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 20px 18px;
      position: relative;
      overflow: hidden;
    }
    .dep-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--amber), transparent);
    }
    .dep-bubble {
      background: #1e1e1e;
      border-radius: 12px 12px 12px 4px;
      padding: 12px 14px;
      font-size: 0.87rem;
      line-height: 1.55;
      color: #e0ddd8;
      margin-bottom: 8px;
    }
    .dep-bubble + .dep-bubble { border-radius: 12px; margin-bottom: 4px; }
    .dep-time { font-size: 0.7rem; color: rgba(255,255,255,0.3); text-align: right; margin-top: 4px; }
    .dep-name {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--amber);
      margin-top: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    /* ─── FAQ ───────────────────────────────────── */
    .section-faq { background: #fff; color: var(--navy); }
    .section-faq .section-tag { color: var(--amber-dark); }
    .section-faq .section-title { color: var(--navy); }
    .section-faq .divider-amber { background: linear-gradient(90deg, var(--amber-dark), transparent); }

    .faq-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 36px;
    }
    @media (max-width: 560px) { .faq-grid { grid-template-columns: 1fr; } }

    .faq-item {
      border-left: 3px solid var(--amber);
      padding-left: 18px;
    }
    .faq-q {
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 10px;
      line-height: 1.3;
    }
    .faq-a {
      font-size: 0.9rem;
      color: #3a4a6b;
      line-height: 1.7;
    }

    /* ─── FINAL CTA ─────────────────────────────── */
    .section-final {
      background: linear-gradient(160deg, var(--navy) 0%, var(--dark) 100%);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .section-final::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(245,158,11,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .section-final .section-title { color: var(--text); }
    .section-final .section-sub { color: var(--muted); max-width: 480px; margin: 0 auto 36px; }
    .contact-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 28px;
    }
    .contact-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 16px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 100px;
      font-size: 0.82rem;
      color: var(--muted);
      text-decoration: none;
      transition: border-color 0.18s, color 0.18s;
    }
    .contact-chip:hover { border-color: var(--amber); color: var(--amber); }
    .contact-chip svg { width: 14px; height: 14px; flex-shrink: 0; }

    /* ─── FOOTER ────────────────────────────────── */
    footer {
      background: var(--dark);
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 28px 24px;
      text-align: center;
      font-size: 0.78rem;
      color: rgba(240,238,232,0.28);
      line-height: 1.8;
    }

    /* ─── ANIMATIONS ────────────────────────────── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
  </style>
</head>
<body>

  <!-- ══ HERO ══════════════════════════════════════ -->
  <section class="hero">
