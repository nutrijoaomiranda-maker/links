  <!-- ══ DEPOIMENTOS ════════════════════════════════ -->
  <section class="section-dep">
    <div class="container reveal">
      <span class="section-tag">Resultados reais</span>
      <h2 class="section-title">Quem já transformou a vida comigo:</h2>
      <div class="divider-amber"></div>
      <p class="dep-sub">Veja o que meus pacientes têm a dizer sobre a jornada de liberdade e bem-estar que construíram com meu acompanhamento:</p>
      <div class="dep-grid">

        <div class="dep-card">
